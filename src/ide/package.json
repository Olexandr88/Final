{
  "name": "llm-framework-ide",
  "version": "1.0.0",
  "description": "AI-powered IDE for LLM Multi-Provider Framework with Claude integration",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "build": "npm run build:monaco && npm run build:react",
    "build:monaco": "node scripts/download-monaco.js",
    "build:react": "webpack --mode production",
    "build:electron": "electron-builder",
    "package": "electron-builder --win --x64",
    "package:all": "electron-builder -mwl",
    "test": "jest",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "monaco-editor": "^0.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.9.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "style-loader": "^3.3.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.llmframework.ide",
    "productName": "LLM Framework IDE",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  },
  "author": {
    "name": "Parker Dunn",
    "email": "scarmonit@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Scarmonit/LLM.git"
  },
  "keywords": [
    "ide",
    "code-editor",
    "monaco",
    "electron",
    "ai",
    "claude",
    "llm",
    "intellisense",
    "typescript",
    "javascript"
  ]
}
