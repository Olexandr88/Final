{
  "name": "a2a-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "agent:continuous": "node --max-old-space-size=2048 --enable-source-maps dist/index.js",
    "vercel:build": "npm run build",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel --prod",
    "try": "node dist/scripts/try.js",
    "deploy:railway": "pwsh -File scripts/railway-deploy.ps1",
    "deploy:vercel": "pwsh -File scripts/vercel-deploy.ps1",
    "deploy:cloudflare": "pwsh -File scripts/cloudflare-deploy.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@types/node-cache": "^4.1.3",
    "@types/nodemailer": "^7.0.2",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.9",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "supertest": "^7.1.4",
    "undici": "^6.22.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
