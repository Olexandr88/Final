# =============================================================================
# Railway Deployment - Autonomous Agent with Cloud Models
# Multi-stage build for optimized production image
# Node.js 22 LTS (Iron) - https://nodejs.org/en/about/previous-releases
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependencies
# Build all dependencies in a separate layer for better caching
# -----------------------------------------------------------------------------
FROM node:22-alpine AS dependencies

# Install build essentials for native modules
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git

WORKDIR /app

# Copy only package files first for better layer caching
COPY package*.json ./

# Install ALL dependencies (including devDependencies for build)
RUN npm install

# -----------------------------------------------------------------------------
# Stage 2: Builder
# Build the application (if needed - TypeScript, bundling, etc.)
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependencies from previous stage
COPY --from=dependencies /app/node_modules ./node_modules

# Copy application source
COPY . .

# Run build command if you have one (uncomment if needed)
# RUN npm run build

# -----------------------------------------------------------------------------
# Stage 3: Production
# Final minimal image with only production dependencies
# -----------------------------------------------------------------------------
FROM node:22-alpine AS production

# Add non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Install only runtime essentials
RUN apk add --no-cache \
    curl \
    ca-certificates \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Change ownership to nodejs user
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Copy package files
COPY --chown=nodejs:nodejs package*.json ./

# Install dependencies using npm install (more lenient than npm ci)
# Since we only have devDependencies, we need to install them
RUN npm install && npm cache clean --force

# Copy application code from builder
COPY --chown=nodejs:nodejs --from=builder /app .

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:${PORT:-8080}/health', (r) => r.statusCode === 200 ? process.exit(0) : process.exit(1))"

# Railway auto-provides PORT environment variable
EXPOSE 8080

# Environment variables documentation (set in Railway Dashboard)
# Required:
# - GITHUB_TOKEN: GitHub Personal Access Token
# - GITHUB_REPO: Repository in format "owner/repo"
# - NODE_ENV: production
# Optional Cloud API Keys:
# - OPENAI_API_KEY: OpenAI API key
# - ANTHROPIC_API_KEY: Anthropic API key  
# - GROQ_API_KEY: Groq API key
# - OLLAMA_BASE_URL: Cloud Ollama instance URL

# Default environment
ENV NODE_ENV=production \
    PORT=8080

# Start the Railway HTTP server (runs autonomous agent in background)
CMD ["node", "server.js"]
