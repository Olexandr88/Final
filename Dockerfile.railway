# Railway Deployment - Autonomous Agent with Cloud Models
# Uses cloud APIs instead of local Ollama
FROM node:18-bullseye

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install Node dependencies
RUN npm install --only=production

# Copy application code
COPY . .

# Expose port for health check (if needed)
EXPOSE 8080

# Environment variables for cloud API keys (set in Railway dashboard)
# OPENAI_API_KEY
# ANTHROPIC_API_KEY
# GROQ_API_KEY
# OLLAMA_BASE_URL (for cloud Ollama instance)

CMD ["npm", "run", "agent:cloud"]
