# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_api_key_here
MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS=4096
TEMPERATURE=1.0

# Google Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Jules API Key
# Get your key from: https://jules.app (Settings > API Keys)
JULES_API_KEY=your_jules_api_key_here

# Ollama Configuration
# For local Ollama: set OLLAMA_API_BASE to your local server
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Ollama Cloud Models (NEW - see docs/OLLAMA_CLOUD_GUIDE.md)
# Cloud endpoint for remote Ollama instances
OLLAMA_CLOUD_ENDPOINT=http://localhost:11434
# API key for hosted providers (Replicate, Modal, etc.)
OLLAMA_CLOUD_API_KEY=
# Cloud model name
OLLAMA_CLOUD_MODEL=llama3
# Enable fallback to local on cloud failure
OLLAMA_FALLBACK_TO_LOCAL=true
# Provider selection: auto, cloud, local
OLLAMA_PROVIDER=auto

# AI Bridge Configuration (for multi-agent coordination)
AI_BRIDGE_PORT=4567
AI_BRIDGE_HTTP_PORT=4568
AI_BRIDGE_URL=ws://localhost:4567
AGENT_ID=agent-dev
AGENT_ROLE=coder

# Performance Configuration (optional)
GLOBAL_TIMEOUT_MS=60000
LOG_LEVEL=info
COMPRESSION_THRESHOLD=1024
MAX_CONNECTIONS=100
HEALTH_CHECK_INTERVAL=10000
RATE_LIMIT_TOKENS=10
OPTIMIZATION_LEVEL=ultra
TARGET_EFFICIENCY=85

# Windows Development Environment Configuration
WINDOWS_DEV_AGENT_URL=ws://localhost:65028
WINGET_ENABLED=true
WSL_ENABLED=true
PWSH_PATH=pwsh
DEFAULT_WSL_DISTRO=Ubuntu-22.04