# Environment Variables Template for www.scarmonit.com
# Copy this file to .env for local development
# NEVER commit .env to Git!

# =============================================================================
# GITHUB CONFIGURATION (Required for all platforms)
# =============================================================================

# GitHub Personal Access Token
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, workflow, write:packages
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub Repository
# Format: owner/repo
GITHUB_REPO=Scarmonit/Final

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node Environment
# Values: development | production | test
NODE_ENV=production

# Application Port (Railway only)
# Railway assigns PORT automatically, but you can set default for local dev
PORT=8080

# =============================================================================
# CLOUDFLARE WORKERS SECRETS
# =============================================================================
# Note: Cloudflare Workers uses wrangler CLI to set secrets
# Do NOT set these in .env - use commands below:
#
# wrangler secret put GITHUB_TOKEN
# wrangler secret put GITHUB_REPO
#
# Cloudflare Zone ID (for wrangler.toml routes)
# Get from: https://dash.cloudflare.com/ → Your Domain → Overview
CLOUDFLARE_ZONE_ID=your_zone_id_here

# =============================================================================
# RAILWAY CONFIGURATION
# =============================================================================
# Set these in Railway Dashboard → Settings → Variables
#
# Required:
# - GITHUB_TOKEN
# - GITHUB_REPO
# - NODE_ENV
# - PORT (auto-assigned by Railway)
#
# Optional Railway-specific variables:
RAILWAY_ENVIRONMENT=production

# =============================================================================
# VERCEL CONFIGURATION
# =============================================================================
# Set these in Vercel Dashboard → Settings → Environment Variables
#
# Required:
# - GITHUB_TOKEN (set as @github-token secret)
# - GITHUB_REPO
# - NODE_ENV
#
# Vercel-specific (auto-provided by Vercel):
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=auto-generated-url.vercel.app
# VERCEL_REGION=iad1

# =============================================================================
# AI/ML CONFIGURATION (Optional)
# =============================================================================

# Ollama API Configuration (for Railway deployment)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# Cloudflare Workers AI Model (auto-configured)
# Uses Cloudflare's AI binding - no API key needed
# Available models: @cf/meta/llama-2-7b-chat-int8, @cf/meta/codellama-7b-instruct-awq

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================

# Log Level
# Values: error | warn | info | debug
LOG_LEVEL=info

# Sentry DSN (for error tracking - optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# SECURITY (Optional but Recommended)
# =============================================================================

# API Keys for additional services (if needed)
# API_KEY=your_api_key_here

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://www.scarmonit.com,https://scarmonit.com

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment Platform Identifiers
PLATFORM=multi  # Values: cloudflare | railway | vercel | multi

# Health Check Configuration
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# INSTRUCTIONS
# =============================================================================
#
# 1. LOCAL DEVELOPMENT:
#    - Copy this file to .env
#    - Fill in your actual values
#    - Add .env to .gitignore (already done)
#
# 2. CLOUDFLARE WORKERS:
#    - Use wrangler CLI to set secrets:
#      wrangler secret put GITHUB_TOKEN
#      wrangler secret put GITHUB_REPO
#
# 3. RAILWAY:
#    - Set variables in Railway Dashboard:
#      Settings → Variables → Add Variable
#    - Railway auto-provides: PORT, RAILWAY_ENVIRONMENT
#
# 4. VERCEL:
#    - Set variables in Vercel Dashboard:
#      Settings → Environment Variables → Add
#    - Use @secret-name format for sensitive values in vercel.json
#    - Vercel auto-provides: VERCEL, VERCEL_ENV, VERCEL_URL
#
# 5. SECURITY:
#    - NEVER commit this file with real values
#    - Rotate tokens every 90 days
#    - Use different tokens for different environments
#    - Enable 2FA on all platform accounts
#
# =============================================================================

